#!/usr/bin/env python3
"""
spark — run a Spark document.

Usage: spark run <doc.md> [--input key=value ...]
       spark run <doc.md> --dry-run
       spark graph <doc.md>

A Spark doc is a markdown file whose fenced ```spark blocks define an
executable process.  The doc IS the runtime: front-matter declares
triggers and inputs; step blocks declare the work; the runner parses,
builds a dependency graph, and dispatches.

Zero external dependencies — runs on a stock Python 3.10+.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import textwrap
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


# ── Minimal YAML-subset parser (frontmatter only) ───────────────────────

def _parse_frontmatter(text: str) -> dict[str, Any]:
    """Parse the YAML between leading --- fences.  Supports scalars,
    lists, and one level of mapping nesting — enough for Spark headers."""
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.DOTALL)
    if not m:
        return {}
    return _mini_yaml(m.group(1))


def _mini_yaml(src: str) -> dict[str, Any]:
    root: dict[str, Any] = {}
    stack: list[tuple[dict, int]] = [(root, -1)]

    for raw_line in src.splitlines():
        stripped = raw_line.rstrip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(raw_line) - len(raw_line.lstrip())
        while stack and indent <= stack[-1][1]:
            stack.pop()
        parent = stack[-1][0] if stack else root

        if ":" in stripped:
            key, _, val = stripped.partition(":")
            key = key.strip()
            val = val.strip()
            if val == "":
                child: dict[str, Any] = {}
                parent[key] = child
                stack.append((child, indent))
            elif val.startswith("[") and val.endswith("]"):
                parent[key] = [v.strip().strip("'\"") for v in val[1:-1].split(",") if v.strip()]
            else:
                parent[key] = _cast(val)
        elif stripped.lstrip().startswith("- "):
            last_key = list(parent.keys())[-1] if parent else None
            if last_key and not isinstance(parent[last_key], list):
                parent[last_key] = []
            if last_key:
                parent[last_key].append(_cast(stripped.lstrip()[2:].strip()))

    return root


def _cast(v: str) -> Any:
    v = v.strip().strip("'\"")
    if v.lower() in ("true", "yes"):
        return True
    if v.lower() in ("false", "no"):
        return False
    try:
        return int(v)
    except ValueError:
        pass
    try:
        return float(v)
    except ValueError:
        pass
    return v


# ── Document model ──────────────────────────────────────────────────────

@dataclass
class Step:
    name: str
    props: dict[str, Any] = field(default_factory=dict)
    needs: list[str] = field(default_factory=list)
    condition: str | None = None
    source_file: str = ""

    @property
    def step_type(self) -> str:
        if "uses" in self.props:
            return "composite"
        return self.props.get("type", "run")

    @property
    def is_agent(self) -> bool:
        return self.step_type == "agent"


@dataclass
class SparkDoc:
    path: Path
    name: str
    frontmatter: dict[str, Any]
    steps: list[Step]
    prose: str

    @property
    def triggers(self) -> list[str]:
        on = self.frontmatter.get("on", ["manual"])
        return on if isinstance(on, list) else [on]

    @property
    def inputs_spec(self) -> dict[str, Any]:
        return self.frontmatter.get("inputs", {})

    @property
    def schedule(self) -> str | None:
        return self.frontmatter.get("schedule")


# ── Parser ──────────────────────────────────────────────────────────────

_STEP_BLOCK = re.compile(
    r"```spark\s+step:\s*(\S+)\s*\n(.*?)```",
    re.DOTALL,
)


def parse(path: Path) -> SparkDoc:
    text = path.read_text()
    fm = _parse_frontmatter(text)

    # strip frontmatter for prose
    prose = re.sub(r"^---\s*\n.*?\n---\s*\n?", "", text, count=1, flags=re.DOTALL)

    steps: list[Step] = []
    for m in _STEP_BLOCK.finditer(text):
        name = m.group(1)
        body = m.group(2)
        props = _mini_yaml(body)
        needs_raw = props.pop("needs", [])
        if isinstance(needs_raw, str):
            needs_raw = [needs_raw]
        cond = props.pop("if", None)
        steps.append(Step(
            name=name,
            props=props,
            needs=needs_raw,
            condition=str(cond) if cond is not None else None,
            source_file=str(path),
        ))

    return SparkDoc(
        path=path,
        name=fm.get("name", path.stem),
        frontmatter=fm,
        steps=steps,
        prose=prose,
    )


# ── Dependency graph ────────────────────────────────────────────────────

def topo_sort(steps: list[Step]) -> list[list[Step]]:
    """Return steps in topological layers (parallelisable within a layer)."""
    by_name = {s.name: s for s in steps}
    in_degree: dict[str, int] = {s.name: 0 for s in steps}
    dependents: dict[str, list[str]] = {s.name: [] for s in steps}

    for s in steps:
        for dep in s.needs:
            if dep not in by_name:
                raise ValueError(f"step '{s.name}' needs unknown step '{dep}'")
            in_degree[s.name] += 1
            dependents[dep].append(s.name)

    layers: list[list[Step]] = []
    ready = [n for n, d in in_degree.items() if d == 0]

    while ready:
        layer = sorted(ready)
        layers.append([by_name[n] for n in layer])
        next_ready: list[str] = []
        for n in layer:
            for dep in dependents[n]:
                in_degree[dep] -= 1
                if in_degree[dep] == 0:
                    next_ready.append(dep)
        ready = next_ready

    scheduled = sum(len(l) for l in layers)
    if scheduled != len(steps):
        raise ValueError("cycle detected in step dependencies")

    return layers


# ── Composite expansion (sub-docs) ─────────────────────────────────────

def expand_composites(doc: SparkDoc, resolved: set[str] | None = None) -> list[Step]:
    """Recursively inline `uses:` references, prefixing step names."""
    if resolved is None:
        resolved = set()
    key = str(doc.path.resolve())
    if key in resolved:
        raise ValueError(f"circular sub-doc reference: {doc.path}")
    resolved.add(key)

    expanded: list[Step] = []
    for step in doc.steps:
        if step.step_type == "composite":
            sub_path = doc.path.parent / step.props["uses"]
            if not sub_path.exists():
                raise FileNotFoundError(f"sub-doc not found: {sub_path}")
            sub_doc = parse(sub_path)
            sub_steps = expand_composites(sub_doc, resolved)
            with_args = step.props.get("with", {})
            prefix = step.name
            for ss in sub_steps:
                ss.name = f"{prefix}/{ss.name}"
                ss.needs = [f"{prefix}/{n}" for n in ss.needs]
                ss.props["_parent_args"] = with_args
                ss.source_file = str(sub_path)
            if sub_steps:
                sub_steps[0].needs.extend(step.needs)
            last_names = [ss.name for ss in sub_steps if not any(
                ss.name in other.needs for other in sub_steps
            )]
            expanded.extend(sub_steps)
            for later in doc.steps:
                if step.name in later.needs:
                    later.needs = [
                        n if n != step.name else last_names[0]
                        for n in later.needs
                    ]
        else:
            expanded.append(step)

    resolved.discard(key)
    return expanded


# ── Variable interpolation ──────────────────────────────────────────────

_VAR_RE = re.compile(r"\$\{(\w+(?:\.\w+)*)}")


def interpolate(value: Any, ctx: dict[str, Any]) -> Any:
    if not isinstance(value, str):
        return value
    def _repl(m: re.Match) -> str:
        parts = m.group(1).split(".")
        cur: Any = ctx
        for p in parts:
            if isinstance(cur, dict):
                cur = cur.get(p, m.group(0))
            else:
                return m.group(0)
        return str(cur)
    return _VAR_RE.sub(_repl, value)


def eval_condition(cond: str | None, ctx: dict[str, Any]) -> bool:
    if cond is None:
        return True
    resolved = interpolate(cond, ctx)
    return resolved not in ("false", "False", "0", "", "None", "no")


# ── Executor ────────────────────────────────────────────────────────────

@dataclass
class StepResult:
    name: str
    status: str  # "ok" | "skipped" | "error"
    step_type: str
    source_file: str
    output: str
    duration_ms: int = 0


def _dispatch(step: Step, ctx: dict[str, Any], dry_run: bool) -> StepResult:
    """Execute a single step (mocked for POC)."""
    if not eval_condition(step.condition, ctx):
        return StepResult(
            name=step.name, status="skipped", step_type=step.step_type,
            source_file=step.source_file,
            output=f"condition '{step.condition}' evaluated to false",
        )

    resolved_props = {
        k: interpolate(v, ctx) for k, v in step.props.items()
        if k not in ("_parent_args",)
    }

    parent_args = step.props.get("_parent_args", {})
    for k, v in parent_args.items():
        resolved_props.setdefault(k, interpolate(v, ctx))

    label = f"[{step.step_type}]"
    detail_parts = []
    for k, v in resolved_props.items():
        detail_parts.append(f"  {k}: {v}")
    detail = "\n".join(detail_parts)

    if step.is_agent:
        prompt_text = resolved_props.get("prompt", "(no prompt)")
        output = f"{label} would invoke LLM with prompt:\n  \"{prompt_text}\""
    elif step.step_type == "http":
        method = resolved_props.get("method", "GET")
        url = resolved_props.get("url", "(no url)")
        output = f"{label} would {method} {url}"
    elif step.step_type == "email":
        to = resolved_props.get("to", "(no recipient)")
        subj = resolved_props.get("subject", "(no subject)")
        output = f"{label} would send email to {to}: \"{subj}\""
    elif step.step_type == "run":
        cmd = resolved_props.get("run", "(no command)")
        output = f"{label} would execute: {cmd}"
    elif step.step_type == "set":
        output = f"{label} would set values:\n{detail}"
    else:
        output = f"{label} would execute with:\n{detail}"

    if dry_run:
        output = "[DRY RUN] " + output

    return StepResult(
        name=step.name, status="ok", step_type=step.step_type,
        source_file=step.source_file, output=output,
    )


# ── Run record (audit trail) ───────────────────────────────────────────

def _run_id(doc_path: Path) -> str:
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    h = hashlib.sha256(f"{doc_path}{ts}".encode()).hexdigest()[:8]
    return f"{ts}-{h}"


def _write_run_record(doc: SparkDoc, run_id: str, inputs: dict,
                       results: list[StepResult], trigger: str):
    record = {
        "run_id": run_id,
        "document": str(doc.path),
        "name": doc.name,
        "trigger": trigger,
        "started_at": datetime.now(timezone.utc).isoformat(),
        "inputs": inputs,
        "steps": [
            {
                "name": r.name,
                "status": r.status,
                "type": r.step_type,
                "source": r.source_file,
                "output": r.output,
            }
            for r in results
        ],
        "outcome": "success" if all(r.status in ("ok", "skipped") for r in results) else "failure",
    }

    runs_dir = doc.path.parent / ".spark-runs"
    runs_dir.mkdir(exist_ok=True)
    record_path = runs_dir / f"{doc.path.stem}-{run_id}.json"
    record_path.write_text(json.dumps(record, indent=2) + "\n")
    return record_path


# ── Main execution ──────────────────────────────────────────────────────

def run(doc_path: Path, inputs: dict[str, Any], *,
        dry_run: bool = False, trigger: str = "manual") -> list[StepResult]:
    doc = parse(doc_path)

    # merge defaults from spec
    for key, spec in doc.inputs_spec.items():
        if key not in inputs:
            if isinstance(spec, dict) and "default" in spec:
                inputs[key] = spec["default"]
            elif not isinstance(spec, dict):
                inputs[key] = spec

    ctx = {"inputs": inputs, "secrets": {}, "env": dict(os.environ)}

    # expand sub-docs, then sort
    steps = expand_composites(doc)
    layers = topo_sort(steps)

    run_id = _run_id(doc_path)

    W = 60
    print(f"{'=' * W}")
    print(f"  spark run: {doc.name}")
    print(f"  document:  {doc_path}")
    print(f"  trigger:   {trigger}")
    print(f"  run_id:    {run_id}")
    print(f"  inputs:    {json.dumps(inputs)}")
    if dry_run:
        print(f"  mode:      DRY RUN")
    print(f"{'=' * W}")
    print()

    results: list[StepResult] = []
    for layer_idx, layer in enumerate(layers):
        if len(layers) > 1:
            parallel_note = f" ({len(layer)} parallel)" if len(layer) > 1 else ""
            print(f"── layer {layer_idx + 1}/{len(layers)}{parallel_note} " + "─" * 30)

        for step in layer:
            result = _dispatch(step, ctx, dry_run)
            results.append(result)

            status_icon = {"ok": "+", "skipped": "-", "error": "!"}[result.status]
            print(f"  [{status_icon}] {result.name}")
            for line in result.output.splitlines():
                print(f"      {line}")
            print()

    ok = sum(1 for r in results if r.status == "ok")
    skipped = sum(1 for r in results if r.status == "skipped")
    errors = sum(1 for r in results if r.status == "error")
    print(f"{'=' * W}")
    print(f"  done: {ok} ok, {skipped} skipped, {errors} errors")

    if not dry_run:
        record_path = _write_run_record(doc, run_id, inputs, results, trigger)
        print(f"  run record: {record_path}")

    print(f"{'=' * W}")
    return results


def graph(doc_path: Path):
    """Print the dependency graph as an ASCII diagram."""
    doc = parse(doc_path)
    steps = expand_composites(doc)
    layers = topo_sort(steps)

    print(f"Execution graph for: {doc.name}")
    print(f"Document: {doc_path}")
    print()

    for i, layer in enumerate(layers):
        names = [s.name for s in layer]
        if len(names) > 1:
            bar = "┬" + "┬".join("─" * (len(n) + 2) for n in names) + "┐"
            cells = "│".join(f" {n} " for n in names)
            print(f"  layer {i+1}:  ├{bar}")
            print(f"           │{cells}│  (parallel)")
        else:
            print(f"  layer {i+1}:  [ {names[0]} ]")

        if i < len(layers) - 1:
            print(f"              │")
            print(f"              ▼")


# ── CLI ─────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="spark",
        description="Run a Spark document — the doc is the runtime.",
    )
    sub = parser.add_subparsers(dest="command")

    run_p = sub.add_parser("run", help="Execute a Spark document")
    run_p.add_argument("doc", type=Path, help="Path to the .md document")
    run_p.add_argument("--input", "-i", action="append", default=[],
                       metavar="key=value", help="Override an input value")
    run_p.add_argument("--dry-run", action="store_true",
                       help="Parse and plan but don't dispatch")
    run_p.add_argument("--trigger", default="manual",
                       help="Which trigger fired (manual, schedule, webhook)")

    graph_p = sub.add_parser("graph", help="Show the execution graph")
    graph_p.add_argument("doc", type=Path, help="Path to the .md document")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    if not args.doc.exists():
        print(f"error: {args.doc} not found", file=sys.stderr)
        sys.exit(1)

    if args.command == "run":
        inputs: dict[str, Any] = {}
        for kv in args.input:
            k, _, v = kv.partition("=")
            inputs[k] = _cast(v)
        run(args.doc, inputs, dry_run=args.dry_run, trigger=args.trigger)

    elif args.command == "graph":
        graph(args.doc)


if __name__ == "__main__":
    main()
